<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_pair" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Moeda / BRL" android:textColor="#66E0BF" android:textStyle="bold" android:textSize="12sp"/>
        <TextView android:id="@+id/widget_settings" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="⚙" android:textSize="22sp" android:textColor="#66E0BF" android:contentDescription="Escolher moeda deste widget" />
        <TextView android:id="@+id/widget_refresh" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="↻" android:textSize="24sp" android:textColor="#66E0BF" android:background="@drawable/widget_button" android:contentDescription="Atualizar cotações de mercado e do Banco Central" />
    </LinearLayout>
    <TextView android:id="@+id/widget_rate" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="40dp" android:text="—" android:textColor="#F2F6F8" android:textSize="30sp" android:textStyle="bold" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="18sp" android:autoSizeMaxTextSize="30sp" android:autoSizeStepGranularity="1sp"/>
    <TextView android:id="@+id/widget_change" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Variação indisponível" android:textColor="#66E0BF" android:textSize="12sp" />
    <TextView android:id="@+id/widget_day_move" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Variação do dia indisponível" android:textColor="#66E0BF" android:textSize="11sp" />
    <TextView android:id="@+id/widget_exact" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="#A5BDB7" android:textSize="10sp" android:visibility="gone" />
    <TextView android:id="@+id/widget_unit" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="1 unidade · PTAX venda · Banco Central" android:textColor="#B0CBC5" android:textSize="10sp" android:maxLines="2"/>
    <TextView android:id="@+id/widget_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Sem cotação carregada" android:textColor="#F2F6F8" android:textSize="11sp"/>
    <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Toque para consultar a fonte" android:textColor="#A5BDB7" android:textSize="10sp" android:maxLines="3"/>
    <TextView android:id="@+id/widget_chart_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Histórico indisponível" android:textColor="#A5BDB7" android:textSize="10sp"/>
    <ImageView android:id="@+id/widget_chart" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" android:scaleType="fitXY" android:contentDescription="Histórico real de 30 dias. Toque no widget para abrir o gráfico detalhado." android:visibility="gone"/>
</LinearLayout>
